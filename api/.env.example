# ── Database (Supabase PostgreSQL) ────────────────────────────────
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
DB_SCHEMA=Tombola_DB

# ── JWT Secrets (generate with: openssl rand -hex 64) ─────────────
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# ── SMS Gateway (for OTP delivery) ────────────────────────────────
SMS_API_URL=https://api.example.com/sms
SMS_API_KEY=your-sms-api-key
# Explicit test mode: skips OTP delivery and accepts 123456. Never enable for a public launch.
DEMO_OTP_ENABLED=false

# Telegram bot identity (BotFather > Login Widget / Mini App). Keep the bot
# token server-side; only the numeric client ID is public in the mobile app.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600

# ── Payment Gateway (Chapa) ──────────────────────────────────────
CHAPA_SECRET_KEY=your-chapa-secret-key
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret

# Skip real Chapa and use the fake checkout page in mobile-app instead —
# ticket issuance/webhook/status-polling still run for real. Set to false
# once real CHAPA_SECRET_KEY above is filled in.
MOCK_PAYMENTS=false

# ── Payment Gateway (Telebirr) ───────────────────────────────────
TELEBIRR_APP_ID=your-telebirr-app-id
TELEBIRR_APP_KEY=your-telebirr-app-key

# ── Mobile app (Chapa return_url target) ──────────────────────────
MOBILE_APP_URL=http://localhost:4345

# ── CORS ─────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:4345,http://localhost:5355,http://localhost,https://localhost,capacitor://localhost

# ── Server ───────────────────────────────────────────────────────
PORT=3435
NODE_ENV=development
