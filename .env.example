# Root-level env file for `docker compose` — Compose auto-loads a `.env`
# sitting next to docker-compose.yml to fill in every ${VAR} in that file.
# This is separate from api/.env, mobile-app/.env, admin-app/.env, which
# are only used by `bun run dev` outside of Docker.
#
# On Coolify: don't create this file at all — set these as this project's
# Environment Variables / Build Variables in the Coolify dashboard instead
# (see deploy/COOLIFY.md for which ones are build-time vs runtime).

# ── Database (existing external Postgres/Supabase — no DB container here) ──
DATABASE_URL=postgresql://user:password@host:5432/postgres
DB_SCHEMA=Tombola_DB
DB_SSL=true
NODE_ENV=development

# ── JWT secrets (generate with: openssl rand -hex 64) ──────────────
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Public URLs — every service's real domain (or localhost:<port> for
#    local testing with docker-compose.override.yml) ────────────────
VITE_API_URL=http://localhost:3435
# The api service's own public URL (same domain as VITE_API_URL above,
# without any /path — used server-side to build absolute links back to
# itself: Chapa's webhook callback_url, uploaded image URLs).
API_BASE_URL=http://localhost:3435
MOBILE_APP_URL=http://localhost:4345
ADMIN_APP_URL=http://localhost:5355
# Include Capacitor's local WebView origins as well as the public web apps.
# Android uses https://localhost; the custom-scheme origin keeps this ready
# for other Capacitor hosts.
CORS_ORIGINS=http://localhost:4345,http://localhost:5355,http://localhost,https://localhost,capacitor://localhost

# Demo OTP may be explicitly enabled only on private development stacks.
# Production rejects demo authentication at startup.
SMS_API_URL=
SMS_API_USERNAME=
SMS_API_PASSWORD=
DEMO_OTP_ENABLED=false

# Telegram (BotFather > Login Widget and Mini App)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CLIENT_ID=
TELEGRAM_AUTH_MAX_AGE_SECONDS=3600
# Generate with: openssl rand -hex 32 — also passed to Telegram's
# setWebhook call (see deploy/COOLIFY.md) so it can verify the webhook
# secret matches on both sides.
TELEGRAM_WEBHOOK_SECRET=

# Mock payments may be enabled only on private development stacks.
MOCK_PAYMENTS=false
CHAPA_SECRET_KEY=your-chapa-secret-key
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret
CHAPA_MODE=live
TELEBIRR_APP_ID=your-telebirr-app-id
TELEBIRR_APP_KEY=your-telebirr-app-key
